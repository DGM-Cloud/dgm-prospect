# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL + PostGIS
# Local Docker:
# DATABASE_URL=postgresql://dgm:dgm_prospect_local@localhost:5432/dgm_prospect?schema=public
# Supabase (Project Settings → Database → URI). Prefer "Direct connection" for Prisma migrations.
# Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public
DATABASE_URL=

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# JWT secret from Project Settings → API → JWT Secret (server-only)
SUPABASE_JWT_SECRET=

# Overture Maps Places (monthly GeoParquet via DuckDB + public S3)
# Default: 2026-10-21.0 — update when a newer release is published
OVERTURE_RELEASE=2026-10-21.0
